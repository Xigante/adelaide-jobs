# ─── Adzuna (fonte oficial, gratuita) ──────────────────────────────
# Registre-se em https://developer.adzuna.com/ — a chave sai na hora.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ─── Alertas de e-mail (fase 2) ────────────────────────────────────
# Caixa dedicada só para alertas de vaga. No Gmail use uma
# "app password", não a senha da conta.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ─── Google Sheets (opcional) ──────────────────────────────────────
# Caminho para o JSON da service account. Compartilhe a planilha
# com o e-mail da service account antes de rodar.
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_ID=

# ─── Gemini (fase 3, ainda não usado) ──────────────────────────────
GEMINI_API_KEY=
